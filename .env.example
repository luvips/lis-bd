# Copiar a .env (nunca versionar .env real — regla 30) y ajustar valores.

POSTGRES_DB=lis_laboratorio
POSTGRES_USER=lis_admin
# Usar un valor largo y aleatorio, ej.: openssl rand -base64 24
POSTGRES_PASSWORD=changeme-use-a-long-random-value

# Solo lo usa docker-compose.override.yml (desarrollo local).
POSTGRES_PORT=5432

# Roles de aplicación (sql/09_roles.sql), mínimo privilegio por módulo.
# La app NUNCA se conecta con POSTGRES_USER/POSTGRES_PASSWORD: eso es
# lis_admin, el dueño del esquema, superusuario del propio bootstrap de la
# imagen de Postgres. Un valor por rol, ej.: openssl rand -base64 24
APP_RECEPCION_PASSWORD=changeme-recepcion
APP_LABORATORIO_PASSWORD=changeme-laboratorio
APP_SUPERVISOR_PASSWORD=changeme-supervisor
APP_CAJA_PASSWORD=changeme-caja
APP_REPORTING_PASSWORD=changeme-reporting

# Tag de la imagen construida, para versionar despliegues en la EC2.
TAG=local
